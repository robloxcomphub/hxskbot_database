# Copy this file to .env for local testing.
# On Render, set these as Environment Variables in the dashboard instead.

DISCORD_TOKEN=your_bot_token_here

# MongoDB Atlas connection string — see README.md for how to get this
# for free from cloud.mongodb.com (M0 free-forever cluster).
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Optional: database name to use inside your cluster. Defaults to "hxskbot".
MONGODB_DB_NAME=hxskbot

# Needed for .gameban / .gameunban — bans a player from your Roblox game (not Discord).
# Create a key at https://create.roblox.com/dashboard/credentials scoped to your
# experience with "universe.user-restriction:write" and "universe.user-restriction:read".
# Keep this secret — never commit it or paste it in Discord.
ROBLOX_API_KEY=your_roblox_open_cloud_api_key_here

# The Universe ID of your experience (Creator Dashboard > your experience > the ID
# in the URL, NOT the individual place ID).
ROBLOX_UNIVERSE_ID=your_universe_id_here
